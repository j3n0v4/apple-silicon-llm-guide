<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vltx.swap-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/swap-guard</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SWAP_THRESHOLD_KB</key>
        <string>1048576</string>
        <key>SWAP_AGGRESSIVE_KB</key>
        <string>4194304</string>
        <key>LOG_FILE</key>
        <string>/tmp/swap-guard.log</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/swap-guard-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/swap-guard-stderr.log</string>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
