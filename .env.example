# Apple Silicon LLM Guide — Environment Variables
# Copy this file to .env and fill in your values.

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=0s
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1

# MLX model paths (for mlx_lm / Rapid-MLX / oMLX)
MLX_MODEL_PATH=/path/to/your/models

# Open WebUI
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_HOST=localhost

# Cloud API (optional — for hybrid local+cloud setups)
CLOUD_API_KEY=your-api-key-here
CLOUD_API_BASE_URL=https://api.example.com/v1
